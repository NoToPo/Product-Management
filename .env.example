# Copy to `.env` (docker-compose reads it automatically). All values have safe defaults.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=productdb
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# --- Used when running the API outside Docker (dotnet run) ---
# These override appsettings.json via .NET configuration.
# ConnectionStrings__Database=Host=localhost;Port=5432;Database=productdb;Username=postgres;Password=postgres
# ConnectionStrings__Redis=localhost:6379
# Database__AutoMigrate=true
